generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MasterData {
  sku     String
  account String @default("Danone")
  descr   String

  @@id([sku, account])
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  name         String
  role         String    @default("USER") // ADMIN or USER
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}
model Inventory {
  sku      String
  account  String   @default("Danone")
  descr    String
  quantity Int    @default(0)

  @@id([sku, account])
}

model InventoryBatch {
  id        Int      @id @default(autoincrement())
  sku       String
  account   String   @default("Danone")
  descr     String
  batch     String
  quantity  Int      @default(0)
  mfgDate   String?
  expDate   String?
  updatedAt DateTime @default(now())

  @@unique([sku, account, batch])
}


model Inbound {
  id        Int      @id @default(autoincrement())
  orderCode String   @default("LEGACY")
  account   String   @default("Danone")
  reversed  Boolean  @default(false)
  date      DateTime
  sku       String
  descr    String
  quantity Int
  status   String?
  remark   String?
  createdBy String  @default("System")
}

model Outbound {
  id        Int      @id @default(autoincrement())
  orderCode String   @default("LEGACY")
  account   String   @default("Danone")
  reversed  Boolean  @default(false)
  date      DateTime
  sku       String
  descr    String
  quantity Int
  status   String?
  remark   String?
  createdBy String  @default("System")
}

model ActionLog {
  id        Int      @id @default(autoincrement())
  userId    String?
  username  String   @default("System")
  action    String
  details   String
  createdAt DateTime @default(now())
}

